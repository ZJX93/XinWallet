node_modules/
.env
*.log
.DS_Store
Thumbs.db
__pycache__/
.venv/
dist/
dist-build/
dist-preview/
dist.prebuild-*/
.cache/
.npm-cache*/
# 本地联调临时产物（token、接口返回快照、进程排查输出等），随时可删
.local-tmp/
inspect-output/
inspect-build-preview.mjs
# 排除临时图片，但保留 logo、images 目录、安卓资源目录及鸿蒙资源目录下的图片
*.png
!images/*.png
!android/app/src/main/res/**/*.png
!harmony/**/resources/base/media/*.png
.workbuddy/
server/routes.js.original
# 一次性审计报告（应在 docs/ 或被 .gitignore）
code-review-report.html
# 本地 SDK / 构建配置，不入库（每台机器路径不同）
local.properties
# Android 调试签名密钥，不应入库（每台机器不同，泄露也无意义）
android/app/debug.keystore
# 鸿蒙 DevEco/IntelliJ IDE 配置（每台机器不同，不入库）
harmony/.idea/
# VS Code 工作区配置（每台机器不同，不入库）
.vscode/
# uitest dumpLayout 调试产物（非源码，不入库）
harmony/*_layout.json
# 本地交接/工作笔记（不入库）
.handover/
# 浏览器自动化（playwright-cli）日志产物，不入库
.playwright-cli/
# UI 布局调试临时页，不入库
public/debug-rect.html

# 鸿蒙签名材料（CI 注入的临时目录 / 本地 base64 中间文件，严禁入库）
harmony/.sign/

# ============ 工作记录 / 调试产物，一律不入库（2026-08-24 清理） ============
# 构建产物的时间戳备份目录（rm 前的保险副本，重新编译即可再生成，单个可达 190MB）
*.bak-[0-9]*/
*.old-[0-9]*/
android/.gradle.bak-*/
android/.gradle.old-*/
android/app/build.bak-*/
harmony/entry/build.bak-*/

# 下划线前缀 = 本机调试中间文件的统一约定
# _tok.txt 曾存放真实 demo JWT（已删）；_ui_dump.xml 是 uiautomator 布局快照
scripts/_*
public/_inject.html
public/_inject/

