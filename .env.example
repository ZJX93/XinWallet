# ============================================================
# XinWallet 环境变量参考模板（.env.example）
# 复制本文件为 .env 后填入真实值；.env 已被 .gitignore 忽略，请勿提交真实密钥。
# 所有 CHANGE_ME_* 占位符都必须替换为实际强随机值后再投产。
# ============================================================

# ===== 数据库配置 =====
# 方言选择：'pg'（PostgreSQL，默认）或 'mysql'（MySQL 8.0+）
DB_DIALECT=pg
DB_NAME=xinwallet
# PostgreSQL 默认端口 5432，MySQL 默认端口 3306
DB_PORT=5432
# 生产环境请使用强随机密码，禁止使用示例值
DB_PASSWORD=CHANGE_ME_strong_db_password

# ===== 应用配置 =====
APP_PORT=18888

# JWT 签名密钥：泄露可伪造任意用户令牌，务必使用强随机值
# 生成: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ===== 加密密钥（用于加密 AI/OCR 等敏感凭证）=====
# 留空 → 首次启动自动生成并写入 /app/data/.encryption-key
# 显式设置 → 优先级最高（推荐单机部署）
# 注意：变更 ENCRYPTION_KEY 后，旧密文无法解密，需通知用户重新保存 AI/OCR 凭证
# ⚠️ 重要：重部署（重建镜像/容器）时务必「固定本变量」或「保留 docker 卷 xinwallet-app-data（内含 /app/data）」。
#    否则加密密钥丢失/变更，已配置的 AI 服务商与 OCR 密钥将无法解密，表现如同「配置丢失」，需到「AI 配置」页重新保存。
# 生成: openssl rand -hex 32
ENCRYPTION_KEY=

# ===== 演示账号 =====
# 生产环境务必设为 false，避免默认弱口令后门
ALLOW_DEMO=false
DEMO_PASSWORD=CHANGE_ME_demo_password
DEV_PASSWORD=CHANGE_ME_dev_password

# ===== CORS 配置 =====
# 仅允许受信任的前端来源，生产环境不要使用 *
CORS_ORIGIN=http://localhost:18888
