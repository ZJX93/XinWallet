# ============================================================
# XinWallet 环境变量参考模板（.env.example）
# 复制本文件为 .env 后填入真实值；.env 已被 .gitignore 忽略，请勿提交真实密钥。
# 所有 CHANGE_ME_* 占位符都必须替换为实际强随机值后再投产。
# ============================================================

# ===== 数据库配置 =====
# 方言选择：'pg'（PostgreSQL，默认）或 'mysql'（MySQL 8.0+）
DB_DIALECT=pg
DB_NAME=xinwallet
# PostgreSQL 默认端口 5432，MySQL 默认端口 3306
DB_PORT=5432
# 生产环境请使用强随机密码，禁止使用示例值
DB_PASSWORD=CHANGE_ME_strong_db_password

# ===== 应用配置 =====
APP_PORT=18888

# JWT 签名密钥：泄露可伪造任意用户令牌，务必使用强随机值
# 生成: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ===== 加密密钥（用于加密 AI/OCR 等敏感凭证）=====
# 留空 → 首次启动自动生成并写入 /app/data/.encryption-key
# 显式设置 → 优先级最高（推荐单机部署）
# 注意：变更 ENCRYPTION_KEY 后，旧密文无法解密，需通知用户重新保存 AI/OCR 凭证
# ⚠️ 重要：重部署（重建镜像/容器）时务必「固定本变量」或「保留 docker 卷 xinwallet-app-data（内含 /app/data）」。
#    否则加密密钥丢失/变更，已配置的 AI 服务商与 OCR 密钥将无法解密，表现如同「配置丢失」，需到「AI 配置」页重新保存。
# 生成: openssl rand -hex 32
ENCRYPTION_KEY=

# ===== 演示账号 =====
# 生产环境务必设为 false，避免默认弱口令后门
ALLOW_DEMO=false
DEMO_PASSWORD=CHANGE_ME_demo_password
DEV_PASSWORD=CHANGE_ME_dev_password

# ===== CORS 配置 =====
# 仅允许受信任的前端来源，生产环境不要使用 *
CORS_ORIGIN=http://localhost:18888

# ===== AI 记账配置 =====
# 🎯 默认配置 = 最全面 + 最智能，【以下全部可省略】。
#    只要在「AI 配置」页填好模型服务商，即可获得完整能力：
#      · 账户白名单：模型拿到你的账户列表，从账单内容匹配账户（而非只能靠关键词猜）
#      · OCR 噪音剔除：过滤网速/订单号/余额等界面元素
#      · 秒级日期、语义化备注
#      · 历史先例：参考你过往对该商家的真实归类来匹配账户与类目
#    版本选择已收敛，不存在"选哪个版本"的问题 —— 默认就是能力全集。

# —— 以下是排障 / 成本 / 隐私开关，正常无需改动 ——

# 关闭历史先例注入（默认开启）。关闭后【类目】匹配退化为纯文本推断，准确率下降。
#   注：账户不依赖先例 —— 账户取自账单原文写明的支付渠道
#       （同一商家可用微信/支付宝/银行卡分别支付，商家推不出账户）。
# ⚠️ 开启时会把最多 4 条【脱敏】历史消费发给你的模型服务商
#    （仅 备注/金额/类目名/账户名，不含交易 id）。不能接受则设为 false。
# AI_FEWSHOT_ENABLED=false

# 关闭第三方模型复核，退回纯本地正则（默认开启；省钱，但识别率显著下降）
# AI_ALLOW_MODEL_ROUTE=false

# 简单输入也过一遍模型（默认 false；用 token 成本换语义准确率）
# AI_MODEL_ROUTE_SIMPLE=true

# 模型主抽取（默认 false）。⚠️ 不建议开启：它会跳过账户的保守合并保护，
#    让本地渠道关键词命中的硬证据被模型软推测覆盖，且模型漏认就会少记笔数。
# AI_LLM_FIRST=true

# 排障用：临时降级 prompt 版本（v3=能力全集 / v2=无历史先例 / v1=冻结基线）
# AI_PARSER_PROMPT_VERSION=v2
