{
  "name": "xinwallet",
  "version": "1.0.0",
  "description": "鑫钱包 - 个人财务助手 (Node.js + Express + PostgreSQL / MySQL 双方言)",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "test:ci": "node scripts/test-ci.js",
    "test:integration": "node scripts/smoke-test.js",
    "test:routes": "node scripts/verify-routes.js",
    "test:full": "node scripts/full-verify.js",
    "mysql:init": "node scripts/mysql-init.js",
    "schema:convert": "node scripts/convert-pg-schema-to-mysql.js",
    "mysql:compat": "node scripts/mysql-compat-fix.js --dry-run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.8.4",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.1",
    "swagger-ui-dist": "^5.32.11",
    "tencentcloud-sdk-nodejs-ocr": "^4.1.268"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
